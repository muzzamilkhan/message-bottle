#!/bin/sh
# Pre-commit checks: lint and tests must pass before a commit lands.
#
# Enable once per clone with:
#   git config core.hooksPath .githooks
#
# Skip for a single commit with `git commit --no-verify` when you need to
# record work in progress.

set -e

# Run against the working tree. On this project that's the same as the staged
# content in the common case (commit everything, no partial staging); if you
# stage selectively, note that the checks see your unstaged edits too.
echo "pre-commit: lint"
npm run --silent lint

echo "pre-commit: tests"
npm run --silent test

echo "pre-commit: typecheck"
npm run --silent typecheck

echo "pre-commit: ok"
