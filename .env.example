# ------------------------------------------------------------------
# Message in a Bottle — environment variables
# Copy this file to `.env` and fill in the values.
# ------------------------------------------------------------------

# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/message_bottle?sslmode=require"

# Auth.js secret — generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-string"

# Google OAuth credentials
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
# For local dev: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Feature flags (Vercel adapter). The `open-bottle-bypass` flag, when enabled,
# lets the child's open link accept a `?test=yes` query param that opens the
# bottle immediately, bypassing the age-based bottle timer and each letter's
# delivery date. Keep it off in production.
#
# FLAGS_SECRET authenticates the Vercel Toolbar's flag overrides — generate one
# with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
FLAGS_SECRET="replace-me-with-a-random-string"

# Edge Config connection string backing the flag values (Vercel → Storage →
# Edge Config). Without it the flag falls back to its default (off).
EDGE_CONFIG="https://edge-config.vercel.com/YOUR_ID?token=YOUR_TOKEN"
# Vercel Blob. The store MUST be created with private access — the mode is
# fixed at creation and cannot be changed. Local development only; on Vercel,
# Functions authenticate with a short-lived OIDC token instead.
BLOB_READ_WRITE_TOKEN=
