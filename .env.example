# ------------------------------------------------------------------
# Message in a Bottle — environment variables
# Copy this file to `.env` and fill in the values.
# ------------------------------------------------------------------

# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/message_bottle?sslmode=require"

# Auth.js secret — generate one with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-string"

# Google OAuth credentials
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
# For local dev: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Vercel Blob storage for photo uploads
# Created automatically when you add Blob storage to your Vercel project,
# or generate a token at https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"
