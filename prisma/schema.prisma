generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----- Auth.js (NextAuth) models -----

model User {
  id              String        @id @default(cuid())
  name            String?
  email           String?       @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  letters         Letter[]
  children        Child[]
  // Children that other parents have shared access to with this user.
  sharedChildren  ChildShare[]  @relation("SharedChildren")
  // Invites this user has created to give co-parents access.
  sentInvites     ShareInvite[] @relation("SentInvites")
  // Invites this user has accepted.
  acceptedInvites ShareInvite[] @relation("AcceptedInvites")
  createdAt       DateTime      @default(now())
  // Subscription tier. Null means free. Read through canUploadImages in
  // src/lib/subscription.ts — never compared directly — so adding a tier is a
  // one-line change there. Set by hand until billing exists.
  subscription    String?
  letterImages    LetterImage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----- App models -----

model Child {
  id          String        @id @default(cuid())
  name        String
  // A cute emoji avatar for the child.
  avatar      String        @default("🧒")
  // A parent-uploaded profile photo as a `data:image/webp;base64,...` URL,
  // already downscaled client-side to 160x160 (~7-9 KB). Null means fall back
  // to the emoji `avatar`. Small enough to sit on the row, but omitted from
  // any `select` that doesn't render it.
  photo       String?       @db.Text
  birthday    DateTime
  // Bottle timer: the age at which this child may open their bottles via the
  // self-authenticating link. Required, and must be greater than their current
  // age when set.
  openAtAge   Int
  // Random, unguessable token for the child's self-authenticating open link
  // (/open/<token>). Generated when a bottle timer is first set.
  openToken   String?       @unique
  // The owner of this child profile. Owners can share access with co-parents.
  parent      User          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  parentId    String
  letters     Letter[]
  // Co-parents who have been granted access to write letters to this child.
  shares      ChildShare[]
  // Pending/accepted invites that include this child.
  inviteLinks InviteChild[]
  createdAt   DateTime      @default(now())

  @@index([parentId])
}

model Letter {
  id            String   @id @default(cuid())
  title         String
  body          String   @db.Text
  // Snapshot of the child's name at write time, kept even if the child
  // profile is later deleted.
  recipientName String
  child         Child?   @relation(fields: [childId], references: [id], onDelete: SetNull)
  childId       String?
  // Lifecycle: "DRAFT" letters are still editable by their author and never
  // reach the child. "SENT" letters are sealed forever — the author can no
  // longer view, edit, or delete them.
  status        String   @default("DRAFT")
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  images        LetterImage[]

  @@index([authorId])
  @@index([childId])
}

// A photo placed inline in a letter body, referenced from the body text by a
// `[[img:<id>]]` marker. The bytes live in a private blob store and are only
// ever served through /api/letter-image/[id], which authorizes every request.
model LetterImage {
  id       String @id @default(cuid())
  // Pathname in the private blob store. Never a public URL — a private store
  // is unreadable by URL at all, which is the point.
  pathname String @unique
  // The stored size, so the renderer can reserve the aspect box before the
  // bytes arrive and the child's page doesn't jump as photos load.
  width    Int
  height   Int
  bytes    Int
  mimeType String
  // Null while the image belongs to a new letter that hasn't been saved yet.
  // Set on the letter's first save. Cascade removes the row with the letter,
  // but NOT the blob — blob deletion is always explicit.
  letter   Letter? @relation(fields: [letterId], references: [id], onDelete: Cascade)
  letterId String?
  // The uploader. Both the upload gate and the orphan sweep hang off this.
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  createdAt DateTime @default(now())

  @@index([letterId])
  // The orphan sweep queries one author's unattached rows by age.
  @@index([authorId, createdAt])
}

// ----- Parent access sharing -----

// A grant of access: `parent` (a co-parent) may write letters to `child`.
// Created when a co-parent accepts a ShareInvite. The child's owner keeps
// full control and can revoke a share at any time.
model ChildShare {
  id        String   @id @default(cuid())
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId   String
  parent    User     @relation("SharedChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String
  createdAt DateTime @default(now())

  @@unique([childId, parentId])
  @@index([parentId])
  @@index([childId])
}

// A share link a parent generates to invite a co-parent. Anyone who opens the
// link can accept it once signed in (creating an account first if needed).
model ShareInvite {
  id           String        @id @default(cuid())
  // The random, unguessable token embedded in the share link.
  token        String        @unique
  inviter      User          @relation("SentInvites", fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId    String
  // "PENDING", "ACCEPTED", or "REVOKED".
  status       String        @default("PENDING")
  children     InviteChild[]
  acceptedBy   User?         @relation("AcceptedInvites", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedById String?
  acceptedAt   DateTime?
  createdAt    DateTime      @default(now())

  @@index([inviterId])
}

// Join table: which children a given invite grants access to.
model InviteChild {
  invite   ShareInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  inviteId String
  child    Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
  childId  String

  @@id([inviteId, childId])
  @@index([childId])
}
